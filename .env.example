# Local development requires no credentials. Save real values in ignored .env.local.
PORT=8802
STOCKSWAP_ORIGIN=http://127.0.0.1:8802
STOCKSWAP_PAYPAL_MODE=mock
STOCKSWAP_PAYPAL_CLIENT_ID=
STOCKSWAP_PAYPAL_CLIENT_SECRET=
STOCKSWAP_PAYPAL_WEBHOOK_ID=
STOCKSWAP_STORE=sqlite
STOCKSWAP_SQLITE_PATH=.local/stockswap.sqlite
STOCKSWAP_BUCKET=stockswap-sessions-564976398462
STOCKSWAP_AI_MODE=mock
STOCKSWAP_AI_BASE_URL=
STOCKSWAP_AI_API_KEY=
STOCKSWAP_AI_MODEL=
STOCKSWAP_AI_APPROVAL=
STOCKSWAP_AI_EXPIRES_AT=
STOCKSWAP_AI_MAX_CALLS=0

# Approved hosting project only. These are deployment references, not created resources.
GCP_PROJECT_ID=tough-melody-508008-p8
GCP_REGION=us-central1
GCP_SERVICE=stockswap
# Attach a dedicated runtime identity at deployment; do not use an existing app identity.
GCP_RUNTIME_SERVICE_ACCOUNT=
# New cloud charges require approval; this placeholder does not grant it.
CLOUD_SPENDING_APPROVAL_REFERENCE=
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
